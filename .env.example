# .env.local 로 복사해서 채운다 (.env.local 은 git 에 안 올라감)

# 로그인 세션 서명 (32자 이상 아무 문자열). 운영·개발 따로 쓰기
AUTH_SECRET=

# 구글 로그인: Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
#   승인된 리디렉션 URI: http://localhost:6900/api/auth/google/callback , https://<운영 도메인>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 운영 주소를 고정하고 싶을 때만 (예: https://chamjal-diary.vercel.app)
AUTH_URL=

# Mongo (DB 이름 chamjal)
MONGODB_URI=
MONGODB_DB=chamjal

# Cafe24 FTP (QR 스튜디오 price_Line/.env 와 같은 이름) — 게시판 그림 저장
FTP_HOST=yogibo.ftp.cafe24.com
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/web/chamjal
PUBLIC_ASSET_BASE=https://yogibo.openhost.cafe24.com/web/chamjal

# Claude: 선생님 한 줄 + 게시판 검사 + AI 그림 장면 정리 (Haiku 5.5)
ANTHROPIC_API_KEY=

# OpenAI: AI 그림 (gpt-image-1-mini 낮은 품질, 한 장 약 6원) — 없으면 [AI 그려 줘]가 '준비 중'으로 보인다
OPENAI_API_KEY=

# 아이 목소리 읽어 주기 (Typecast). 비우면 버튼이 안 보인다.
#   지금은 보이스동화·한글나라와 같은 계정이라 넣지 않는다 → 이 앱 전용 요금제·키를 받으면 넣기
#   개발 시험은 npm run dev:mem -- --voice ../todo/.env.local
TYPECAST_API_KEY=

# 교무실(/admin): 선생님 아이디 fe(개발)·yogico(클라이언트) 두 개만 아이디 로그인으로 들어온다 (src/lib/staff.ts).
# 일반 사용자는 구글로만 가입한다. 선생님 비밀번호를 잊으면 scripts/account.mjs reset

# 개발용 로그인 (운영에서는 무시됨)
DEV_LOGIN=1

# 베타 서버 (11-10): 기본은 src/lib/business.ts BETA = true → 배포한 서버(운영 빌드)에서 저절로 켜진다. 정식 출시 전에 false.
#   켜지면 · "이름만 적고 시작하기"(개발용 로그인)를 연다 — 구글 로그인 전까지
#          · 처음 온 사람은 예제 일기장(fe = 3학년 8반 길동, scripts/demo.mjs build)으로 로그인된 채 둘러본다 (읽기만)
#   이 값은 덮어쓸 때만: 1 = 로컬에서도 켜기(시험), 0 = 배포에서도 끄기. 보통은 비워 둔다
BETA=
